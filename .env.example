# bunyaitterの環境変数サンプル
# 基本的にはこのファイルをコピーして.envという名前に変更して使ってください。。
# Nyaitter↔bunyaitter間で環境変数の互換性は無いことに留意してください。

## 1. 基本

# サーバーが使うポート番号
PORT = 3000
# Discord や SNS に投稿リンクを貼ったときに、投稿内容や画像を表示させるポート番号
POST_SHARE_PORT = 3000

## 2. データベース

# こちらをご参照ください: https://bun.com/docs/runtime/sql#database-environment-variables
DATABASE_URL = sqlite://:memory:

# メディア保存先の種類: 'local' (サーバー内に保存), 's3' (AWS S3・Cloudflare R2等のS3プロトコルのストレージに保存)
STORAGE_ADAPTER = local
# 以下はSTORAGE_ADAPTER=s3の時に使用。こちらをご参照ください: https://bun.com/docs/runtime/sql#database-environment-variables
# S3_ACCESS_KEY_ID =
# S3_SECRET_ACCESS_KEY =
# S3_REGION =
# S3_ENDPOINT =
# S3_BUCKET =
# S3_SESSION_TOKEN =

# 1人あたりのメディア保存上限
STORAGE_USER_QUOTA_MB = 512

## 3. 認証

AUTH_METHOD_SCRATCH_ENABLED = true
AUTH_METHOD_PASSKEY_ENABLED = true
AUTH_METHOD_EMAIL_ENABLED = false

# 信頼済みIPハッシュ用のシークレット鍵（未設定時は data/.auth_hmac_secret に自動保存されます）
# LOGIN_SECURITY_HMAC_SECRET=your-random-hmac-secret-key-here

## 4. AI(AutoMod)
# API キーとモデル名を入力すると、ルール違反の投稿を AI が自動で判定します。
# OpenAI 互換 API や Google Gemini が利用できます。
AUTOMOD_API_KEY =
AUTOMOD_MODEL = gpt-4o-mini
AUTOMOD_PROMPT = 基本的には緩めに判断してください。過度に不適切な場合のみ対応するようにしてください。
# OpenAI 以外の互換サービス（Groq、Ollama、OpenRouter 等）を使う場合は URL を設定します
# AUTOMOD_ENDPOINT=https://api.openai.com/v1
